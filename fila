/* Fundo animado */
body::before{
    content:'';
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:
    radial-gradient(circle at 20% 20%,rgba(96,165,250,.25),transparent 30%),
    radial-gradient(circle at 80% 60%,rgba(59,130,246,.2),transparent 35%);
    z-index:-1;
    animation:bgMove 12s infinite alternate;
}

@keyframes bgMove{
    from{
        transform:scale(1);
    }
    to{
        transform:scale(1.2);
    }
}

/* Navegação */
nav{
    position:fixed;
    top:0;
    width:100%;
    padding:20px 8%;
    backdrop-filter:blur(20px);
    background:rgba(15,23,42,.6);
    display:flex;
    justify-content:space-between;
    align-items:center;
    z-index:1000;
}

nav ul{
    display:flex;
    gap:30px;
    list-style:none;
}

nav a{
    color:white;
    text-decoration:none;
    transition:.3s;
}

nav a:hover{
    color:#60a5fa;
}

/* Cards Premium */
.card{
    transition:.4s;
    border:1px solid rgba(255,255,255,.1);
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:
    0 20px 40px rgba(96,165,250,.25),
    0 0 20px rgba(96,165,250,.15);
}

/* Botões Premium */
.btn{
    position:relative;
    overflow:hidden;
}

.btn::before{
    content:'';
    position:absolute;
    left:-100%;
    top:0;
    width:100%;
    height:100%;
    background:rgba(255,255,255,.2);
    transition:.6s;
}

.btn:hover::before{
    left:100%;
}

/* Estatísticas */
.stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:20px;
    padding:80px 10%;
}

.counter-box{
    text-align:center;
    background:rgba(255,255,255,.06);
    padding:30px;
    border-radius:20px;
    backdrop-filter:blur(15px);
}

.counter-box h2{
    font-size:3rem;
    color:#60a5fa;
}

/* Reveal Animation */
.reveal{
    opacity:0;
    transform:translateY(60px);
    transition:.8s;
}

.reveal.active{
    opacity:1;
    transform:translateY(0);
}

/* Botão Voltar ao Topo */
.scroll-top{
    position:fixed;
    bottom:25px;
    right:25px;
    width:55px;
    height:55px;
    border:none;
    border-radius:50%;
    background:#2563eb;
    color:white;
    cursor:pointer;
    display:none;
    box-shadow:0 10px 30px rgba(37,99,235,.5);
}
